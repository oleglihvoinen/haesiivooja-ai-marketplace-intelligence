{
  "name": "haesiivooja-mysql-cdc",
  "config": {
    "connector.class": "io.debezium.connector.mysql.MySqlConnector",
    "database.hostname": "mysql",
    "database.port": "3306",
    "database.user": "cdc_user",
    "database.password": "${MYSQL_CDC_PASSWORD}",
    "database.server.id": "184054",
    "topic.prefix": "haesiivooja",
    "database.include.list": "haesiivooja",
    "table.include.list": "haesiivooja.bookings,haesiivooja.cleaner_availability,haesiivooja.ratings",
    "schema.history.internal.kafka.bootstrap.servers": "kafka:9092",
    "schema.history.internal.kafka.topic": "schema-changes.haesiivooja",
    "include.schema.changes": "true",
    "snapshot.mode": "initial"
  }
}
